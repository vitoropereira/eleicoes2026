[{"id":"dividido-br","titulo":"Eleitor de Lula, deputado do lado de Flávio","numero":"13,8 milhões","texto":"Estimativa: 25,8% dos eleitores de Lula votaram em deputado federal de partido que apoia Flávio (faixa de 90%: 23,9% a 27,2%). Entre eleitores de Flávio, o caminho inverso foi 1,6%.","est":true,"ancora":"#voto-dividido","refs":[{"arq":"dividido.json","caminho":["BR","depfed","lula_para_F","v"],"fmt":"mi","texto":"13,8 milhões"},{"arq":"dividido.json","caminho":["BR","depfed","lula_para_F","pct"],"fmt":"pct","texto":"25,8%"},{"arq":"dividido.json","caminho":["intervalo"],"fmt":"pct0","texto":"90%"},{"arq":"dividido.json","caminho":["BR","depfed","lula_para_F","int",0],"fmt":"pct","texto":"23,9%"},{"arq":"dividido.json","caminho":["BR","depfed","lula_para_F","int",1],"fmt":"pct","texto":"27,2%"},{"arq":"dividido.json","caminho":["BR","depfed","flavio_para_L","pct"],"fmt":"pct","texto":"1,6%"}]},{"id":"cadeiras-depfed","titulo":"Câmara: votos e cadeiras do lado de Lula","numero":"127","texto":"Lula teve 53,9 milhões de votos. Os partidos do seu lado fizeram 26,8% dos votos para deputado federal e elegeram 127 das 513 cadeiras. O lado de Flávio elegeu 295.","est":false,"ancora":"#votos-cadeiras","refs":[{"arq":"cadeiras.json","caminho":["BR","depfed","cadeiras","L"],"fmt":"int","texto":"127"},{"arq":"campos.json","caminho":["BR","presidente","L"],"fmt":"mi","texto":"53,9 milhões"},{"arq":"cadeiras.json","caminho":["BR","depfed","votos","L"],"fmt":"pct","texto":"26,8%"},{"arq":"cadeiras.json","caminho":["BR","depfed","cadeiras","L"],"fmt":"int","texto":"127"},{"arq":"cadeiras.json","caminho":["BR","depfed","total"],"fmt":"int","texto":"513"},{"arq":"cadeiras.json","caminho":["BR","depfed","cadeiras","F"],"fmt":"int","texto":"295"}]},{"id":"campos-depfed","titulo":"Do voto em Lula ao voto em deputado","numero":"30,5 milhões","texto":"Lula: 53,9 milhões de votos. Deputados federais dos partidos do lado de Lula: 30,5 milhões. Do lado de Flávio: 60,7 milhões; do centro: 22,5 milhões.","est":false,"ancora":"#campos","refs":[{"arq":"campos.json","caminho":["BR","depfed","L"],"fmt":"mi","texto":"30,5 milhões"},{"arq":"campos.json","caminho":["BR","presidente","L"],"fmt":"mi","texto":"53,9 milhões"},{"arq":"campos.json","caminho":["BR","depfed","L"],"fmt":"mi","texto":"30,5 milhões"},{"arq":"campos.json","caminho":["BR","depfed","F"],"fmt":"mi","texto":"60,7 milhões"},{"arq":"campos.json","caminho":["BR","depfed","C"],"fmt":"mi","texto":"22,5 milhões"}]},{"id":"divergencia-mun","titulo":"Lula na frente, deputado do outro lado","numero":"1.406","texto":"Em 1.406 municípios Lula teve mais votos que Flávio, mas o lado de Flávio somou mais votos para deputado federal. O inverso aconteceu em 38.","est":false,"ancora":"#divergencias","refs":[{"arq":"divergencias.json","caminho":["uf","BR","depfed","lula_e_F"],"fmt":"int","texto":"1.406"},{"arq":"divergencias.json","caminho":["uf","BR","depfed","lula_e_F"],"fmt":"int","texto":"1.406"},{"arq":"divergencias.json","caminho":["uf","BR","depfed","flavio_e_L"],"fmt":"int","texto":"38"}]},{"id":"puxador","titulo":"O maior puxador de votos","numero":"3.119.318","texto":"Nikolas Ferreira (PL-MG) teve 3.119.318 votos, 14,5 vezes o quociente eleitoral do estado. Pela conta aproximada, ajudou a eleger mais 13 colegas.","est":true,"ancora":"#puxadores","refs":[{"arq":"puxadores.json","caminho":["depfed",0,"votos"],"fmt":"int","texto":"3.119.318"},{"arq":"puxadores.json","caminho":["depfed",0,"votos"],"fmt":"int","texto":"3.119.318"},{"arq":"puxadores.json","caminho":["depfed",0,"vezes_quociente"],"fmt":"x1","texto":"14,5"},{"arq":"puxadores.json","caminho":["depfed",0,"puxados_estimados"],"fmt":"int","texto":"13"}]},{"id":"viradas","titulo":"Viradas desde 2022","numero":"461","texto":"461 municípios deram vitória a Lula no 2º turno de 2022 e agora deram mais votos a Flávio. No sentido contrário (Bolsonaro em 2022, Lula em 2026): 1.","est":false,"ancora":"#comparacao-2022","refs":[{"arq":"comparacao2022.json","caminho":["viradas","lula_para_flavio"],"fmt":"int","texto":"461"},{"arq":"comparacao2022.json","caminho":["viradas","lula_para_flavio"],"fmt":"int","texto":"461"},{"arq":"comparacao2022.json","caminho":["viradas","bolsonaro_para_lula"],"fmt":"int","texto":"1"}]},{"id":"precisa","titulo":"Quanto cada um precisa dos eliminados","numero":"38,06%","texto":"Para vencer, Flávio precisa de 38,06% dos 9,3 milhões de votos dos candidatos eliminados; Lula, de 61,94%. Conta sobre votos válidos, sem prever abstenção.","est":false,"ancora":"#cenarios","refs":[{"arq":"cenarios.json","caminho":["precisa","flavio_pct_dos_eliminados"],"fmt":"pp2","texto":"38,06%"},{"arq":"cenarios.json","caminho":["precisa","flavio_pct_dos_eliminados"],"fmt":"pp2","texto":"38,06%"},{"arq":"cenarios.json","caminho":["precisa","eliminados_votos"],"fmt":"mi","texto":"9,3 milhões"},{"arq":"cenarios.json","caminho":["precisa","lula_pct_dos_eliminados"],"fmt":"pp2","texto":"61,94%"}]},{"id":"fragmentacao","titulo":"Uma Câmara de muitos partidos","numero":"20","texto":"20 partidos elegeram deputado federal. O número efetivo de partidos (que pesa o tamanho de cada um) é 8,8. Partidos sem lado no 2º turno ficaram com 17,7% das cadeiras.","est":false,"ancora":"#fragmentacao","refs":[{"arq":"fragmentacao.json","caminho":["BR","depfed","partidos_com_cadeira"],"fmt":"int","texto":"20"},{"arq":"fragmentacao.json","caminho":["BR","depfed","partidos_com_cadeira"],"fmt":"int","texto":"20"},{"arq":"fragmentacao.json","caminho":["BR","depfed","nep_cadeiras"],"fmt":"x1","texto":"8,8"},{"arq":"fragmentacao.json","caminho":["BR","depfed","centro_pct_cadeiras"],"fmt":"pct","texto":"17,7%"}]}]